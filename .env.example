# Display currency: NGN (Naira) or XOF (CFA franc). Demo catalog switches with it.
CURRENCY=NGN
# Price of 1 BTC in the display currency. Locked into each order at creation.
BTC_PRICE_LOCAL=150000000
# How long a payment may stay locked before it auto-refunds (minutes). Use 2 for live demos.
LOCK_MINUTES=60

# Optional: AI reads WhatsApp orders via Groq (free key at console.groq.com).
# Without a key, a built-in rule parser is used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: publish verified reviews to Nostr relays (comma separated).
NOSTR_RELAYS=
# Optional: fixed notary key (hex). Random per start if empty.
NOSTR_NOTARY_SECRET_HEX=

# Number of reverse proxies in front of the app (1 on Render/Railway/Fly). Leave 0 for local/Docker.
TRUST_PROXY=0

# Set by deploy.sh for a public server (leave empty locally).
DOMAIN=
GEM_BIND=0.0.0.0
